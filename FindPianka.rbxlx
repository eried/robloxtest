<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[return {
	GameName = "Find Pianka",
	Creator = "Mr. Scientist 84",
	CatName = "Pianka",
	CatColor = Color3.fromRGB(25, 25, 28),
	EyeColor = Color3.fromRGB(255, 210, 40),

	ForestSize = 600,
	TreeCount = 350,
	BushCount = 150,
	RockCount = 60,
	SpawnClearRadius = 30,
	MinCatDistance = 150,
	HomePosition = Vector3.new(10, 0, 0),
	HomeRadius = 8,

	GpsRange = 200,

	FleeDistance = 20,
	HardFlees = 3,
	KittenCount = 7,
	KittenTime = 180,

	DayMinutes = 8,
	StartClock = 15,

	-- Upload music/PiankaMystery.mp3 to Roblox and paste its id here
	MusicId = 0,
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="5">
        <Properties>
          <string name="Name">ForestGame</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local rng = Random.new()
local half = Config.ForestSize / 2
local treeSpots: { Vector3 } = {}

local catEvent = Instance.new("RemoteEvent")
catEvent.Name = "PiankaEvent"
catEvent.Parent = ReplicatedStorage

local modeEvent = Instance.new("RemoteEvent")
modeEvent.Name = "SetMode"
modeEvent.Parent = ReplicatedStorage
modeEvent.OnServerEvent:Connect(function(player, isHard)
	player:SetAttribute("Hard", isHard == true)
end)

local function makePart(class: string, props: { [string]: any }): BasePart
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local function isFree(pos: Vector3, radius: number): boolean
	for _, spot in treeSpots do
		if (spot - pos).Magnitude < radius then
			return false
		end
	end
	return true
end

local function randomSpot(margin: number): Vector3
	return Vector3.new(rng:NextNumber(-half + margin, half - margin), 0, rng:NextNumber(-half + margin, half - margin))
end

-- Sky and fog
Lighting.ClockTime = Config.StartClock
workspace:SetAttribute("DayStart", workspace:GetServerTimeNow())
Lighting.Brightness = 2
Lighting.OutdoorAmbient = Color3.fromRGB(120, 140, 120)
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.45
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(190, 215, 190)
atmosphere.Decay = Color3.fromRGB(90, 120, 90)
atmosphere.Haze = 2
atmosphere.Parent = Lighting

-- Ground
local baseplate = workspace:FindFirstChild("Baseplate")
if baseplate then
	baseplate:Destroy()
end
local terrain = workspace.Terrain
terrain:Clear()
terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(80, 130, 55))
terrain:FillBlock(CFrame.new(0, -6, 0), Vector3.new(Config.ForestSize + 40, 12, Config.ForestSize + 40), Enum.Material.Grass)

-- Camp
local camp = Instance.new("Folder")
camp.Name = "Camp"
camp.Parent = workspace

local spawnPad = Instance.new("SpawnLocation")
spawnPad.Anchored = true
spawnPad.Size = Vector3.new(10, 1, 10)
spawnPad.Position = Vector3.new(0, 0.5, 0)
spawnPad.Color = Color3.fromRGB(140, 100, 60)
spawnPad.Material = Enum.Material.WoodPlanks
spawnPad.Neutral = true
spawnPad.Duration = 0
spawnPad.Parent = camp

local sign = makePart("Part", {
	Name = "Sign",
	Size = Vector3.new(8, 4, 0.5),
	Position = Vector3.new(0, 5, -8),
	Color = Color3.fromRGB(160, 110, 60),
	Material = Enum.Material.Wood,
	Parent = camp,
})
makePart("Part", {
	Name = "Post",
	Size = Vector3.new(0.6, 3, 0.6),
	Position = Vector3.new(0, 1.5, -8),
	Color = Color3.fromRGB(110, 75, 40),
	Material = Enum.Material.Wood,
	Parent = camp,
})
local signGui = Instance.new("SurfaceGui")
signGui.Face = Enum.NormalId.Back
signGui.Parent = sign
local signText = Instance.new("TextLabel")
signText.Size = UDim2.fromScale(1, 1)
signText.BackgroundTransparency = 1
signText.Font = Enum.Font.FredokaOne
signText.TextScaled = true
signText.TextColor3 = Color3.new(1, 1, 1)
signText.Text = "Lost cat: " .. Config.CatName .. "!\nFind her and bring her home"
signText.Parent = signGui

-- Cat bed
local home = Config.HomePosition
makePart("Part", {
	Name = "BedRim",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(1.4, 7, 7),
	CFrame = CFrame.new(home + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	Color = Color3.fromRGB(120, 60, 140),
	Material = Enum.Material.Fabric,
	Parent = camp,
})
local cushion = makePart("Part", {
	Name = "BedCushion",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(1, 5.6, 5.6),
	CFrame = CFrame.new(home + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	Color = Color3.fromRGB(230, 170, 220),
	Material = Enum.Material.Fabric,
	Parent = camp,
})
local bedTag = Instance.new("BillboardGui")
bedTag.Size = UDim2.fromOffset(200, 40)
bedTag.StudsOffset = Vector3.new(0, 4, 0)
bedTag.MaxDistance = 80
bedTag.Parent = cushion
local bedText = Instance.new("TextLabel")
bedText.Size = UDim2.fromScale(1, 1)
bedText.BackgroundTransparency = 1
bedText.Font = Enum.Font.FredokaOne
bedText.TextScaled = true
bedText.TextColor3 = Color3.fromRGB(255, 200, 240)
bedText.TextStrokeTransparency = 0.3
bedText.Text = Config.CatName .. "'s bed"
bedText.Parent = bedTag

-- Forest
local forest = Instance.new("Folder")
forest.Name = "Forest"
forest.Parent = workspace

local leafColors = {
	Color3.fromRGB(60, 120, 50),
	Color3.fromRGB(75, 140, 60),
	Color3.fromRGB(50, 105, 45),
}

local function makeTree(pos: Vector3)
	local tree = Instance.new("Model")
	tree.Name = "Tree"
	local height = rng:NextNumber(10, 18)
	local width = rng:NextNumber(1.6, 2.6)
	makePart("Part", {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, width, width),
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(100, 70, 45),
		Material = Enum.Material.Wood,
		Parent = tree,
	})
	if rng:NextNumber() < 0.5 then
		local color = leafColors[rng:NextInteger(1, #leafColors)]
		for _ = 1, 3 do
			local size = rng:NextNumber(7, 11)
			local offset = Vector3.new(rng:NextNumber(-2, 2), height + rng:NextNumber(-1, 2), rng:NextNumber(-2, 2))
			makePart("Part", {
				Name = "Leaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * size,
				Position = pos + offset,
				Color = color,
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = tree,
			})
		end
	else
		local size = rng:NextNumber(9, 12)
		local y = height * 0.55
		for i = 1, 4 do
			makePart("Part", {
				Name = "Needles",
				Size = Vector3.new(size, 3, size),
				CFrame = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.rad(45 * i), 0),
				Color = Color3.fromRGB(35, 85, 45),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = tree,
			})
			size *= 0.72
			y += 2.8
		end
	end
	tree.Parent = forest
end

local placed = 0
for _ = 1, Config.TreeCount * 5 do
	if placed >= Config.TreeCount then
		break
	end
	local pos = randomSpot(5)
	if pos.Magnitude > Config.SpawnClearRadius and isFree(pos, 9) then
		table.insert(treeSpots, pos)
		makeTree(pos)
		placed += 1
	end
end

for _ = 1, Config.BushCount do
	local pos = randomSpot(5)
	if pos.Magnitude > Config.SpawnClearRadius then
		local size = rng:NextNumber(3, 6)
		makePart("Part", {
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			Position = pos + Vector3.new(0, size * 0.3, 0),
			Color = leafColors[rng:NextInteger(1, #leafColors)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = forest,
		})
	end
end

for _ = 1, Config.RockCount do
	local pos = randomSpot(5)
	if pos.Magnitude > Config.SpawnClearRadius then
		local size = Vector3.new(rng:NextNumber(2, 6), rng:NextNumber(1.5, 4), rng:NextNumber(2, 6))
		makePart("Part", {
			Name = "Rock",
			Size = size,
			CFrame = CFrame.new(pos + Vector3.new(0, size.Y * 0.35, 0))
				* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
			Color = Color3.fromRGB(115, 115, 110),
			Material = Enum.Material.Slate,
			Parent = forest,
		})
	end
end

-- Invisible walls
for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
	makePart("Part", {
		Name = "Wall",
		Size = Vector3.new(
			if side.X ~= 0 then 2 else Config.ForestSize,
			60,
			if side.Z ~= 0 then 2 else Config.ForestSize
		),
		Position = side * half + Vector3.new(0, 30, 0),
		Transparency = 1,
		Parent = forest,
	})
end

-- Lantern
local lantern = Instance.new("Tool")
lantern.Name = "Lantern"
lantern.CanBeDropped = false
lantern.GripPos = Vector3.new(0, 0.9, 0)
local lanternHandle = makePart("Part", {
	Name = "Handle",
	Size = Vector3.new(0.7, 0.9, 0.7),
	Color = Color3.fromRGB(255, 200, 90),
	Material = Enum.Material.Neon,
	Anchored = false,
	CanCollide = false,
	Massless = true,
	Parent = lantern,
})
for _, y in { 0.55, -0.55 } do
	local cap = makePart("Part", {
		Name = "Cap",
		Size = Vector3.new(0.9, 0.2, 0.9),
		CFrame = CFrame.new(0, y, 0),
		Color = Color3.fromRGB(40, 35, 30),
		Material = Enum.Material.Metal,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = lantern,
	})
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = lanternHandle
	weld.Part1 = cap
	weld.Parent = cap
end
local lanternLight = Instance.new("PointLight")
lanternLight.Range = 30
lanternLight.Brightness = 2.5
lanternLight.Color = Color3.fromRGB(255, 190, 110)
lanternLight.Shadows = true
lanternLight.Parent = lanternHandle

local function giveLantern(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local tool = lantern:Clone()
	tool.Parent = player:WaitForChild("Backpack")
	humanoid:EquipTool(tool)
end

-- Pianka
type Cat = {
	model: Model,
	body: BasePart,
	tail: BasePart,
	tailRest: CFrame,
	tagText: TextLabel,
	sparkles: Sparkles,
}

local function makeCat(base: CFrame, scale: number): Cat
	local model = Instance.new("Model")
	model.Name = Config.CatName

	local function add(name: string, class: string, size: Vector3, pos: Vector3, color: Color3?, rotation: CFrame?): BasePart
		return makePart(class, {
			Name = name,
			Size = size * scale,
			CFrame = base * CFrame.new(pos * scale) * (rotation or CFrame.identity),
			Color = color or Config.CatColor,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = model,
		})
	end

	local body = add("Body", "Part", Vector3.new(1.6, 1.4, 2.6), Vector3.new(0, 1.4, 0))
	local head = add("Head", "Part", Vector3.new(1.5, 1.3, 1.3), Vector3.new(0, 2.3, -1.5))
	add("Muzzle", "Part", Vector3.new(0.8, 0.5, 0.2), Vector3.new(0, 2.05, -2.2))
	add("Nose", "Part", Vector3.new(0.25, 0.2, 0.1), Vector3.new(0, 2.25, -2.32), Color3.fromRGB(55, 55, 60))
	for _, x in { -0.38, 0.38 } do
		local eye = add("Eye", "Part", Vector3.new(0.3, 0.3, 0.3), Vector3.new(x, 2.55, -2.15), Config.EyeColor) :: Part
		eye.Shape = Enum.PartType.Ball
		eye.Material = Enum.Material.Neon
	end
	add("EarL", "WedgePart", Vector3.new(0.4, 0.6, 0.5), Vector3.new(-0.45, 3.25, -1.5), nil, CFrame.Angles(0, math.rad(90), 0))
	add("EarR", "WedgePart", Vector3.new(0.4, 0.6, 0.5), Vector3.new(0.45, 3.25, -1.5), nil, CFrame.Angles(0, math.rad(-90), 0))
	for _, x in { -0.5, 0.5 } do
		for _, z in { -0.9, 0.9 } do
			add("Leg", "Part", Vector3.new(0.4, 0.8, 0.4), Vector3.new(x, 0.4, z))
		end
	end
	local tail = add("Tail", "Part", Vector3.new(0.3, 0.3, 1.8), Vector3.new(0, 2, 1.7), nil, CFrame.Angles(math.rad(-50), 0, 0))
	model.PrimaryPart = body

	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(160, 40)
	tag.StudsOffset = Vector3.new(0, 2, 0)
	tag.MaxDistance = 40
	tag.AlwaysOnTop = true
	tag.Parent = head
	local tagText = Instance.new("TextLabel")
	tagText.Size = UDim2.fromScale(1, 1)
	tagText.BackgroundTransparency = 1
	tagText.Font = Enum.Font.FredokaOne
	tagText.TextScaled = true
	tagText.TextColor3 = Color3.new(1, 1, 1)
	tagText.TextStrokeTransparency = 0.3
	tagText.Text = Config.CatName .. " 🐱"
	tagText.Parent = tag

	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 220, 120)
	sparkles.Parent = body

	return {
		model = model,
		body = body,
		tail = tail,
		tailRest = body.CFrame:ToObjectSpace(tail.CFrame),
		tagText = tagText,
		sparkles = sparkles,
	}
end

local function wagTail(tail: BasePart): Tween
	local tween = TweenService:Create(
		tail,
		TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ CFrame = tail.CFrame * CFrame.Angles(0, math.rad(30), 0) }
	)
	tween:Play()
	return tween
end

local function spawnWildCat(pos: Vector3): (Cat, ProximityPrompt)
	local cat = makeCat(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), 1)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pick up"
	prompt.ObjectText = Config.CatName
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = cat.body
	cat.model.Parent = workspace
	return cat, prompt
end

local function carryCat(character: Model): Cat?
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local cat = makeCat(head.CFrame * CFrame.new(0, head.Size.Y / 2, 0), 0.6)
	for _, part in cat.model:GetChildren() do
		if part:IsA("BasePart") then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = if part == cat.body then head else cat.body
			weld.Part1 = part
			weld.Parent = part
			part.Anchored = false
			part.Massless = true
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	cat.model.Parent = character
	return cat
end

local function farFromPlayers(pos: Vector3): boolean
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - pos).Magnitude < Config.MinCatDistance then
			return false
		end
	end
	return true
end

local function findCatSpot(): Vector3
	for _ = 1, 300 do
		local pos = randomSpot(15)
		if pos.Magnitude >= Config.MinCatDistance and isFree(pos, 5) and farFromPlayers(pos) then
			return pos
		end
	end
	return randomSpot(15)
end

local round = 0
local wildPrompt: ProximityPrompt? = nil
local wildTween: Tween? = nil
local fleesLeft = 0
local fleeing = false
local wildCat: Cat? = nil
local carried: Cat? = nil
local homeCat: Cat? = nil
local carrier: Player? = nil

local function removeCat(cat: Cat?)
	if cat then
		cat.model:Destroy()
	end
end

local newRound: () -> ()

local kittenFolder = Instance.new("Folder")
kittenFolder.Name = "Kittens"
kittenFolder.Parent = workspace
local kittens: { Cat } = {}
local kittensLeft = 0

local function fleeFrom(cat: Cat, prompt: ProximityPrompt, player: Player, from: Vector3)
	local start = cat.model:GetPivot()
	local catPos = Vector3.new(start.X, 0, start.Z)
	local away = Vector3.new(catPos.X - from.X, 0, catPos.Z - from.Z)
	away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)

	local target: Vector3? = nil
	for i = 1, 16 do
		local spread = if i <= 6 then 0.8 else math.pi
		local dir = CFrame.Angles(0, rng:NextNumber(-spread, spread), 0):VectorToWorldSpace(away)
		local pos = catPos + dir * rng:NextNumber(40, 60)
		if math.abs(pos.X) < half - 15 and math.abs(pos.Z) < half - 15 and isFree(pos, 5) then
			target = pos
			break
		end
	end
	if not target then
		return
	end

	fleeing = true
	fleesLeft -= 1
	prompt.Enabled = false
	if wildTween then
		wildTween:Cancel()
	end
	cat.tail.CFrame = cat.body.CFrame * cat.tailRest
	catEvent:FireClient(player, "fled")

	local lift = Vector3.new(0, start.Y, 0)
	local dir = (target - catPos).Unit
	local fromCf = CFrame.lookAt(start.Position, start.Position + dir)
	local goalCf = CFrame.lookAt(target + lift, target + lift + dir)
	local t0 = os.clock()
	local alpha = 0
	while alpha < 1 and cat.model.Parent do
		alpha = math.min((os.clock() - t0) / 1.5, 1)
		local hop = math.abs(math.sin(alpha * math.pi * 6)) * 0.8
		local cf = fromCf:Lerp(goalCf, alpha)
		cat.model:PivotTo(cf + Vector3.new(0, hop, 0))
		workspace:SetAttribute("CatPosition", Vector3.new(cf.X, 0, cf.Z))
		RunService.Heartbeat:Wait()
	end

	if wildCat == cat then
		wildTween = wagTail(cat.tail)
		prompt.Enabled = true
	end
	fleeing = false
end

local function loseCat()
	local myRound = round
	removeCat(carried)
	carried, carrier = nil, nil
	workspace:SetAttribute("Carrier", nil)
	catEvent:FireAllClients("lost")
	task.wait(2)
	if round == myRound then
		newRound()
	end
end

local function deliver(player: Player)
	local myRound = round
	removeCat(carried)
	carried, carrier = nil, nil
	workspace:SetAttribute("Carrier", nil)

	local stats = player:FindFirstChild("leaderstats")
	local count = stats and stats:FindFirstChild("Rescued") :: IntValue?
	if count then
		count.Value += 1
	end

	homeCat = makeCat(CFrame.new(home + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, math.rad(90), 0), 1)
	local cat = homeCat :: Cat
	cat.tagText.Text = "Home! ❤️"
	cat.sparkles.SparkleColor = Color3.fromRGB(255, 120, 180)
	cat.model.Parent = workspace

	local seconds = workspace:GetServerTimeNow() - (workspace:GetAttribute("RoundStart") :: number)
	catEvent:FireAllClients("home", player, seconds)
	task.wait(6)
	if round == myRound then
		newRound()
	end
end

local function kittenSpot(center: Vector3, taken: { Vector3 }): Vector3
	for _ = 1, 200 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local pos = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(40, 160)
		local ok = math.abs(pos.X) < half - 10 and math.abs(pos.Z) < half - 10 and isFree(pos, 4)
		for _, other in taken do
			if (other - pos).Magnitude < 25 then
				ok = false
			end
		end
		if ok then
			return pos
		end
	end
	return randomSpot(15)
end

local function makeKitten(cf: CFrame): Cat
	local kitten = makeCat(cf, 0.45)
	kitten.model.Name = "Kitten"
	kitten.tagText.Text = "Kitten"
	local tag = kitten.tagText.Parent :: BillboardGui
	tag.MaxDistance = 25
	kitten.sparkles:Destroy()
	table.insert(kittens, kitten)
	return kitten
end

local function collectKitten(kitten: Cat, player: Player)
	if kitten.model.Parent ~= kittenFolder or kittensLeft <= 0 then
		return
	end
	local myRound = round
	removeCat(kitten)
	kittensLeft -= 1

	local angle = (Config.KittenCount - kittensLeft) / Config.KittenCount * math.pi * 2
	local spot = home + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 5
	makeKitten(CFrame.lookAt(spot, Vector3.new(home.X, 0, home.Z))).model.Parent = workspace

	local stats = player:FindFirstChild("leaderstats")
	local count = stats and stats:FindFirstChild("Rescued") :: IntValue?
	if count then
		count.Value += 1
	end
	workspace:SetAttribute("KittensLeft", kittensLeft)
	catEvent:FireAllClients("kitten", player, kittensLeft)

	if kittensLeft == 0 then
		workspace:SetAttribute("KittenDeadline", nil)
		local seconds = workspace:GetServerTimeNow() - (workspace:GetAttribute("RoundStart") :: number)
		catEvent:FireAllClients("allKittens", player, seconds)
		task.wait(8)
		if round == myRound then
			newRound()
		end
	end
end

local function startKittens(cat: Cat)
	local myRound = round
	local center = cat.model:GetPivot().Position
	removeCat(cat)
	wildCat = nil
	workspace:SetAttribute("CatPosition", nil)

	local boom = Instance.new("Explosion")
	boom.Position = center
	boom.BlastPressure = 0
	boom.DestroyJointRadiusPercent = 0
	boom.ExplosionType = Enum.ExplosionType.NoCraters
	boom.Parent = workspace

	homeCat = makeCat(CFrame.new(home + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, math.rad(90), 0), 1)
	local mom = homeCat :: Cat
	mom.tagText.Text = "Mama " .. Config.CatName
	mom.model.Parent = workspace

	local taken: { Vector3 } = {}
	for _ = 1, Config.KittenCount do
		local pos = kittenSpot(Vector3.new(center.X, 0, center.Z), taken)
		table.insert(taken, pos)
		local kitten = makeKitten(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Pick up"
		prompt.ObjectText = "Kitten"
		prompt.HoldDuration = 0.2
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.Parent = kitten.body
		prompt.Triggered:Connect(function(player)
			collectKitten(kitten, player)
		end)
		kitten.model.Parent = kittenFolder
	end
	kittensLeft = Config.KittenCount
	workspace:SetAttribute("KittensLeft", kittensLeft)
	workspace:SetAttribute("KittenDeadline", workspace:GetServerTimeNow() + Config.KittenTime)
	catEvent:FireAllClients("kittens")

	task.wait(Config.KittenTime)
	if round == myRound and kittensLeft > 0 then
		kittensLeft = 0
		kittenFolder:ClearAllChildren()
		workspace:SetAttribute("KittenDeadline", nil)
		catEvent:FireAllClients("timeUp")
		task.wait(4)
		if round == myRound then
			newRound()
		end
	end
end

function newRound()
	removeCat(wildCat)
	removeCat(carried)
	removeCat(homeCat)
	for _, kitten in kittens do
		removeCat(kitten)
	end
	table.clear(kittens)
	kittensLeft = 0
	workspace:SetAttribute("KittensLeft", nil)
	workspace:SetAttribute("KittenDeadline", nil)
	wildCat, carried, homeCat, carrier = nil, nil, nil, nil
	round += 1

	local pos = findCatSpot()
	local cat, prompt = spawnWildCat(pos)
	wildCat = cat
	wildPrompt = prompt
	wildTween = wagTail(cat.tail)
	fleesLeft = Config.HardFlees
	fleeing = false
	workspace:SetAttribute("CatPosition", pos)
	workspace:SetAttribute("Carrier", nil)
	workspace:SetAttribute("RoundStart", workspace:GetServerTimeNow())

	prompt.Triggered:Connect(function(player)
		local character = player.Character
		if wildCat ~= cat or fleeing or not character then
			return
		end
		if player:GetAttribute("Hard") then
			startKittens(cat)
			return
		end
		local newCarried = carryCat(character)
		if not newCarried then
			return
		end
		removeCat(cat)
		wildCat = nil
		carried = newCarried
		carrier = player
		workspace:SetAttribute("CatPosition", nil)
		workspace:SetAttribute("Carrier", player.UserId)
		catEvent:FireAllClients("picked", player)

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Died:Once(function()
				if carrier == player then
					loseCat()
				end
			end)
		end
	end)
end

local function addPlayer(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local count = Instance.new("IntValue")
	count.Name = "Rescued"
	count.Parent = stats
	stats.Parent = player

	player.CharacterAdded:Connect(function(character)
		giveLantern(player, character)
	end)
	if player.Character then
		task.spawn(giveLantern, player, player.Character)
	end
end

Players.PlayerAdded:Connect(addPlayer)
for _, player in Players:GetPlayers() do
	addPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	if carrier == player then
		loseCat()
	end
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local cat, prompt = wildCat, wildPrompt
		if cat and prompt and not fleeing and fleesLeft > 0 then
			local catPos = cat.model:GetPivot().Position
			for _, p in Players:GetPlayers() do
				local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if p:GetAttribute("Hard") and r and (r.Position - catPos).Magnitude < Config.FleeDistance then
					task.spawn(fleeFrom, cat, prompt, p, r.Position)
					break
				end
			end
		end

		local player = carrier
		local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if player and root then
			local offset = root.Position - home
			if Vector3.new(offset.X, 0, offset.Z).Magnitude < Config.HomeRadius then
				deliver(player)
			end
		end
	end
end)

newRound()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="6">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="7">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="9">
          <Properties>
            <string name="Name">GPS</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local catEvent = ReplicatedStorage:WaitForChild("PiankaEvent") :: RemoteEvent
local modeEvent = ReplicatedStorage:WaitForChild("SetMode") :: RemoteEvent

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local GREEN = Color3.fromRGB(90, 220, 110)
local FONT = Enum.Font.FredokaOne

local function new(class: string, props: { [string]: any }): any
	local obj = Instance.new(class)
	for key, value in props do
		if key ~= "Parent" then
			(obj :: any)[key] = value
		end
	end
	obj.Parent = props.Parent
	return obj
end

local function round(parent: Instance, radius: UDim)
	new("UICorner", { CornerRadius = radius, Parent = parent })
end

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local gui = new("ScreenGui", {
	Name = "GPS",
	ResetOnSpawn = false,
	Parent = player:WaitForChild("PlayerGui"),
})

-- GPS device
local device = new("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -20, 1, -20),
	Size = UDim2.fromOffset(200, 260),
	BackgroundColor3 = Color3.fromRGB(35, 40, 35),
	Parent = gui,
})
round(device, UDim.new(0, 18))
new("UIStroke", { Color = GREEN, Thickness = 3, Parent = device })

new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 28),
	Position = UDim2.fromOffset(0, 4),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 22,
	TextColor3 = GREEN,
	Text = "GPS",
	Parent = device,
})

local RADAR = 170
local radar = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 34),
	Size = UDim2.fromOffset(RADAR, RADAR),
	BackgroundColor3 = Color3.fromRGB(15, 45, 22),
	Parent = device,
})
round(radar, UDim.new(1, 0))

for _, scale in { 0.33, 0.66 } do
	local ring = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(scale, scale),
		BackgroundTransparency = 1,
		Parent = radar,
	})
	round(ring, UDim.new(1, 0))
	new("UIStroke", { Color = GREEN, Transparency = 0.6, Parent = ring })
end

new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(20, 20),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 18,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "▲",
	ZIndex = 3,
	Parent = radar,
})

local catDot = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(28, 28),
	BackgroundTransparency = 1,
	TextSize = 24,
	Text = "🐱",
	ZIndex = 4,
	Parent = radar,
})

local distanceLabel = new("TextLabel", {
	Position = UDim2.new(0, 8, 1, -50),
	Size = UDim2.new(1, -16, 0, 22),
	BackgroundTransparency = 1,
	Font = FONT,
	TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "",
	Parent = device,
})

local hintLabel = new("TextLabel", {
	Position = UDim2.new(0, 0, 1, -28),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 16,
	TextColor3 = GREEN,
	Text = "",
	Parent = device,
})

local beep = new("Sound", {
	SoundId = "rbxasset://sounds/electronicpingshort.wav",
	Volume = 0.3,
	Parent = gui,
})

-- Music
local music = new("Sound", {
	SoundId = if Config.MusicId ~= 0 then "rbxassetid://" .. Config.MusicId else "",
	Looped = true,
	Volume = 0.5,
	Parent = gui,
})

-- Timer
local timerLabel = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 10),
	Size = UDim2.fromOffset(140, 40),
	BackgroundColor3 = Color3.fromRGB(35, 40, 35),
	BackgroundTransparency = 0.2,
	Font = FONT,
	TextSize = 24,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "⏱ 0:00",
	Parent = gui,
})
round(timerLabel, UDim.new(0, 12))

local musicButton = new("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 100, 0, 10),
	Size = UDim2.fromOffset(40, 40),
	BackgroundColor3 = Color3.fromRGB(35, 40, 35),
	BackgroundTransparency = 0.2,
	TextSize = 22,
	Text = "🎵",
	Visible = Config.MusicId ~= 0,
	Parent = gui,
})
round(musicButton, UDim.new(0, 12))
musicButton.Activated:Connect(function()
	music.Playing = not music.Playing
	musicButton.Text = if music.Playing then "🎵" else "🔇"
end)

-- Banner
local banner = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(560, 110),
	BackgroundColor3 = Color3.fromRGB(35, 40, 35),
	BackgroundTransparency = 0.15,
	Font = FONT,
	TextSize = 34,
	TextColor3 = Color3.new(1, 1, 1),
	TextWrapped = true,
	Visible = false,
	Parent = gui,
})
round(banner, UDim.new(0, 18))
new("UIStroke", { Color = GREEN, Thickness = 3, Parent = banner })

local bannerId = 0
local function showBanner(text: string, duration: number)
	bannerId += 1
	local id = bannerId
	banner.Text = text
	banner.Visible = true
	task.delay(duration, function()
		if id == bannerId then
			banner.Visible = false
		end
	end)
end

local function confetti()
	local colors = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 210, 70), GREEN, Color3.fromRGB(90, 160, 255), Color3.fromRGB(255, 130, 200) }
	for _ = 1, 60 do
		local piece = new("Frame", {
			Position = UDim2.new(math.random(), 0, 0, -20),
			Size = UDim2.fromOffset(10, 16),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Parent = gui,
		})
		local tween = TweenService:Create(piece, TweenInfo.new(math.random(20, 40) / 10, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(math.random(), 0, 1, 20),
			Rotation = piece.Rotation + math.random(-360, 360),
		})
		tween.Completed:Once(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

-- Intro
local intro = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.4,
	ZIndex = 10,
	Parent = gui,
})
local card = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(460, 300),
	BackgroundColor3 = Color3.fromRGB(35, 40, 35),
	ZIndex = 11,
	Parent = intro,
})
round(card, UDim.new(0, 20))
new("UIStroke", { Color = GREEN, Thickness = 4, Parent = card })
new("TextLabel", {
	Position = UDim2.fromOffset(0, 20),
	Size = UDim2.new(1, 0, 0, 50),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 46,
	TextColor3 = Color3.fromRGB(255, 180, 90),
	Text = Config.GameName .. " 🐱",
	ZIndex = 12,
	Parent = card,
})
new("TextLabel", {
	Position = UDim2.fromOffset(0, 72),
	Size = UDim2.new(1, 0, 0, 22),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 18,
	TextColor3 = Color3.fromRGB(180, 180, 180),
	Text = "by " .. Config.Creator,
	ZIndex = 12,
	Parent = card,
})
new("TextLabel", {
	Position = UDim2.fromOffset(30, 110),
	Size = UDim2.new(1, -60, 0, 80),
	BackgroundTransparency = 1,
	Font = FONT,
	TextSize = 22,
	TextWrapped = true,
	TextColor3 = Color3.new(1, 1, 1),
	Text = Config.CatName .. " the cat is lost in the forest! Use your GPS to find her and bring her home.",
	ZIndex = 12,
	Parent = card,
})
local playing = false
local hard = false
local nextGlitch = 0
local glitchUntil = 0

local function modeButton(text: string, color: Color3, x: number, isHard: boolean)
	local button = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, x, 1, -24),
		Size = UDim2.fromOffset(160, 56),
		BackgroundColor3 = color,
		Font = FONT,
		TextSize = 30,
		TextColor3 = Color3.fromRGB(20, 20, 20),
		Text = text,
		ZIndex = 12,
		Parent = card,
	})
	round(button, UDim.new(0, 14))
	button.Activated:Connect(function()
		playing = true
		hard = isHard
		modeEvent:FireServer(isHard)
		if Config.MusicId ~= 0 then
			music:Play()
		end
		if isHard then
			nextGlitch = os.clock() + 12
			local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
			if atmosphere then
				atmosphere.Density = 0.7
			end
		end
		intro:Destroy()
	end)
end
modeButton("Easy", GREEN, -90, false)
modeButton("Hard", Color3.fromRGB(255, 120, 90), 90, true)

-- Events
local function nameOf(who: Player?): string
	return if who then who.DisplayName else "Someone"
end

catEvent.OnClientEvent:Connect(function(kind: string, who: Player?, value: number?)
	local cat = Config.CatName
	if kind == "picked" then
		if who == player then
			showBanner("You found " .. cat .. "! 🐱\nBring her home to her bed.", 4)
		else
			showBanner(nameOf(who) .. " found " .. cat .. "!", 3)
		end
	elseif kind == "home" then
		local time = formatTime(value or 0)
		if who == player then
			showBanner(cat .. " is home! 🎉\nTime: " .. time, 5)
			confetti()
		else
			showBanner(nameOf(who) .. " brought " .. cat .. " home!\nTime: " .. time, 5)
		end
		task.delay(6, function()
			showBanner(cat .. " ran away again! Use your GPS.", 3)
		end)
	elseif kind == "lost" then
		showBanner("Oh no! " .. cat .. " ran away!", 3)
	elseif kind == "fled" then
		showBanner(cat .. " ran off! Chase her!", 2)
	elseif kind == "kittens" then
		showBanner("💥 Surprise! " .. cat .. " had " .. Config.KittenCount .. " kittens!\nFind them before time runs out!", 5)
	elseif kind == "kitten" then
		local finder = if who == player then "You" else nameOf(who)
		showBanner(finder .. " found a kitten! 🐾\n" .. (value or 0) .. " left", 2)
	elseif kind == "allKittens" then
		showBanner("All kittens found! 🎉\nTime: " .. formatTime(value or 0), 6)
		confetti()
		task.delay(8, function()
			showBanner(cat .. " ran away again! Use your GPS.", 3)
		end)
	elseif kind == "timeUp" then
		showBanner("Time's up! ⏰\nThe kittens ran home.", 4)
	end
end)

-- Day and night
local DAY_AMBIENT = Color3.fromRGB(120, 140, 120)
local NIGHT_AMBIENT = Color3.fromRGB(25, 28, 45)

local function updateSky()
	local dayStart = workspace:GetAttribute("DayStart") :: number?
	if not dayStart then
		return
	end
	local hours = (workspace:GetServerTimeNow() - dayStart) / (Config.DayMinutes * 60) * 24
	local clock = (Config.StartClock + hours) % 24
	local daylight = math.clamp(math.sin((clock - 6) / 12 * math.pi) * 3, 0, 1)
	Lighting.ClockTime = clock
	Lighting.OutdoorAmbient = NIGHT_AMBIENT:Lerp(DAY_AMBIENT, daylight)
	Lighting.Brightness = 0.3 + 1.7 * daylight
end

local function nearestKitten(from: Vector3): (Vector3?, number)
	local folder = workspace:FindFirstChild("Kittens")
	local best: Vector3? = nil
	local bestDistance = math.huge
	local count = 0
	if folder then
		for _, kitten in folder:GetChildren() do
			if kitten:IsA("Model") then
				count += 1
				local pos = kitten:GetPivot().Position
				local distance = (pos - from).Magnitude
				if distance < bestDistance then
					best, bestDistance = pos, distance
				end
			end
		end
	end
	return best, count
end

-- Update loop
local lastBeep = 0
local lastForward = Vector3.new(0, 0, -1)

RunService.RenderStepped:Connect(function()
	updateSky()

	local start = workspace:GetAttribute("RoundStart") :: number?
	local catPos = workspace:GetAttribute("CatPosition") :: Vector3?
	local carrierId = workspace:GetAttribute("Carrier") :: number?
	local deadline = workspace:GetAttribute("KittenDeadline") :: number?
	local serverNow = workspace:GetServerTimeNow()
	if deadline then
		local left = deadline - serverNow
		timerLabel.Text = "⏳ " .. formatTime(left)
		timerLabel.TextColor3 = if left < 30 then Color3.fromRGB(255, 90, 90) else Color3.new(1, 1, 1)
	elseif start and (catPos or carrierId) then
		timerLabel.Text = "⏱ " .. formatTime(serverNow - start)
		timerLabel.TextColor3 = Color3.new(1, 1, 1)
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?

	local target: Vector3?, mode = nil, "cat"
	local kittensLeft = 0
	if catPos then
		target = catPos
	elseif deadline and root then
		target, kittensLeft = nearestKitten(root.Position)
		mode = "kitten"
	elseif carrierId == player.UserId then
		target, mode = Config.HomePosition, "home"
	end

	if not root or not target then
		catDot.Visible = false
		hintLabel.Text = ""
		if carrierId then
			distanceLabel.Text = nameOf(Players:GetPlayerByUserId(carrierId)) .. " has " .. Config.CatName
		else
			distanceLabel.Text = ""
		end
		return
	end

	if hard then
		local now = os.clock()
		if now > nextGlitch then
			glitchUntil = now + math.random(3, 5)
			nextGlitch = glitchUntil + math.random(10, 18)
		end
		if now < glitchUntil then
			local static = math.random(20, 60)
			radar.BackgroundColor3 = Color3.fromRGB(static, static, static)
			catDot.Visible = false
			distanceLabel.Text = "No signal"
			hintLabel.Text = "..."
			return
		end
	end
	radar.BackgroundColor3 = Color3.fromRGB(15, 45, 22)

	local offset = target - root.Position
	offset = Vector3.new(offset.X, 0, offset.Z)
	local distance = offset.Magnitude

	local look = camera.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude > 0.01 then
		lastForward = flatLook.Unit
	end
	local right = Vector3.new(-lastForward.Z, 0, lastForward.X)

	local x = offset:Dot(right)
	local y = -offset:Dot(lastForward)
	if distance > Config.GpsRange then
		x = x / distance * Config.GpsRange
		y = y / distance * Config.GpsRange
	end
	local scale = (RADAR / 2 - 14) / Config.GpsRange
	catDot.Visible = true
	catDot.Text = if mode == "home" then "🏠" elseif mode == "kitten" then "🐾" else "🐱"
	catDot.Position = UDim2.new(0.5, x * scale, 0.5, y * scale)

	local meters = math.floor(distance * 0.28)
	local label = if mode == "home" then "Home" elseif mode == "kitten" then "Kitten" else Config.CatName
	distanceLabel.Text = label .. ": " .. meters .. " m"
	if mode == "home" then
		hintLabel.Text = if distance < 50 then "Almost home!" else "Bring her home!"
	elseif mode == "kitten" then
		hintLabel.Text = kittensLeft .. " of " .. Config.KittenCount .. " kittens left"
	elseif distance < 15 then
		hintLabel.Text = "She is right here!"
	elseif distance < 50 then
		hintLabel.Text = "Very close!"
	elseif distance < 150 then
		hintLabel.Text = "Getting closer"
	else
		hintLabel.Text = "Far away"
	end

	local interval = math.clamp(distance / 100, 0.15, 2)
	local now = os.clock()
	if playing and now - lastBeep > interval then
		lastBeep = now
		beep.PlaybackSpeed = if distance < 50 then 1.3 else 1
		beep:Play()
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
